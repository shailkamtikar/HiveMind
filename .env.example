# Copy to .env.local and fill in. Never commit .env.local (it is git-ignored).

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npx supabase db push` from your machine (Project settings > Database). Not needed on Vercel.
SUPABASE_DB_PASSWORD=

# --- Gemini (https://aistudio.google.com/apikey) ---
# Server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- App ---
# The public address of this deployment; invitation links are built from it.
APP_BASE_URL=http://localhost:3000
# live (default) | off (stop all AI processing). `mock` exists for automated tests and is ignored in production.
# AI_MODE=live

# --- Optional limits (defaults shown) ---
MAX_GROUP_MEMBERS=5
MAX_MESSAGE_LENGTH=1000
AI_CONTEXT_MESSAGES=20
INVITE_EXPIRY_DAYS=3
MESSAGES_PER_MINUTE=20
AI_CALLS_PER_MINUTE=6

# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only (used from Milestone 4.4 and for tests). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server only (used from Milestone 4.3).
GEMINI_API_KEY=
GEMINI_MODEL=
APP_BASE_URL=http://localhost:3000

# Optional limits (defaults shown)
MAX_GROUP_MEMBERS=5
MAX_MESSAGE_LENGTH=1000
AI_CONTEXT_MESSAGES=20
INVITE_EXPIRY_DAYS=3
